# Supabase — get these from your project's API settings
# https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the Supabase server client for admin operations (bypasses RLS)
# Keep this secret — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for metadata, canonicals, sitemap, and open graph tags
NEXT_PUBLIC_SITE_URL=https://toluwanimiodufeko.com
