      </div>

      {/* Title & Category */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div className="flex flex-col gap-1.5">
          <label htmlFor="title" className={labelClass}>
            Photo Title *
          </label>
          <input
            id="title"
            name="title"
            type="text"
            required
